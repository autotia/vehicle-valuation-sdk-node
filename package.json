{
  "name": "@autotia/vehicle-valuation-sdk",
  "version": "0.1.0-beta.0",
  "description": "SDK oficial de Node.js y TypeScript para la API de tasación vehicular de Autotia",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/run.test.js",
    "lint": "biome check src test scripts",
    "check:package": "publint && attw --pack . --profile esm-only",
    "smoke": "node scripts/smoke.js"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.10.2",
    "publint": "0.3.12",
    "typescript": "5.7.3"
  }
}
