            "executionId": "exec-401-a",
            "durationMs": 1,
            "error": {
              "code": "unauthorized",
              "description": "credencial ausente"
            }
          }
        },
        {
          "status": 200,
          "headers": {
            "content-type": "application/json",
            "etag": "\"cat-v1\"",
            "cache-control": "private, max-age=0, must-revalidate"
          },
          "body": {
            "data": { "catalogVersion": "cat-v1", "marks": [] },
            "apiRequestId": "req-401-b",
            "executionId": "exec-401-b",
            "durationMs": 2
          }
        }
      ],
      "expected": {
        "kind": "value",
        "value": { "catalogVersion": "cat-v1", "marks": [] },
        "tokenRefreshes": 1,
        "retry": { "retryable": true, "maxRetries": 1 }
      }
    },
