{
  "formatVersion": 1,
  "description": "Pares de respuestas HTTP y resultados esperados del SDK. Valores ilustrativos; los cuerpos y headers son datos JSON.",
  "cases": [
    {
      "id": "http-400-invalid-request",
      "request": { "method": "POST", "path": "/v1/vehicle-valuation" },
      "responses": [
        {
          "status": 400,
          "headers": { "content-type": "application/json" },
          "body": {
            "data": null,
            "apiRequestId": "req-400",
            "executionId": "exec-400",
            "durationMs": 1,
            "error": {
              "code": "invalid_request",
              "description": "solicitud inválida"
            }
          }
        }
      ],
      "expected": {
        "kind": "error",
        "class": "BadRequestError",
        "code": "invalid_request",
        "retry": { "retryable": false, "maxRetries": 0 }
      }
    },
    {
      "id": "http-401-refresh-once",
      "request": { "method": "GET", "path": "/v1/catalog" },
      "responses": [
        {
          "status": 401,
          "headers": { "content-type": "application/json" },
          "body": {
            "data": null,
